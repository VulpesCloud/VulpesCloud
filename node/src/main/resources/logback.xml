<configuration>
    <import class="org.vulpesstudios.vulpescloud.node.terminal.ConsoleAppender"/>
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
    <import class="ch.qos.logback.core.rolling.RollingFileAppender"/>
    <import class="ch.qos.logback.classic.filter.ThresholdFilter"/>
    <import class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"/>

    <conversionRule conversionWord="levelColor" class="org.vulpesstudios.vulpescloud.node.terminal.CompositeConverterImpl"/>

    <variable name="cloud.log.level" value="DEBUG"/>

    <property name="LINE_PATTERN"
              value="%gray([%boldWhite(%d{dd.MM HH:mm:ss.SSS}%gray(]))) %gray(%levelColor(%-5level)) %gray(:)&lt;reset&gt; %msg"/>

    <appender name="ConsoleAppender" class="ConsoleAppender">
        <filter class="ThresholdFilter">
            <level>ALL</level>
        </filter>
        <encoder class="PatternLayoutEncoder">
            <pattern>${LINE_PATTERN}</pattern>
        </encoder>
    </appender>
    <appender name="Rolling" class="RollingFileAppender">
        <file>local/logs/latest.log</file>
        <rollingPolicy class="SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>local/logs/vulpescloud-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>15MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="PatternLayoutEncoder">
            <pattern>[%d{dd.MM HH:mm:ss.SSS}] [%thread] %-5level: %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${cloud.log.level}">
        <appender-ref ref="ConsoleAppender"/>
        <appender-ref ref="Rolling"/>
    </root>

</configuration>
